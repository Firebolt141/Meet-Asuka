# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed to the repository.

# 4-digit PIN used to log in to the planner.
NEXT_PUBLIC_LOGIN_PIN=0000

# Weather location (Shinjuku, Tokyo defaults — change if needed).
# Find coordinates at https://www.latlong.net/
NEXT_PUBLIC_WEATHER_LAT=35.6896
NEXT_PUBLIC_WEATHER_LON=139.7006
